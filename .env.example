# E-commerce GAUL — environment variables
# Salin file ini ke .env lalu isi sesuai environment kamu.

# MySQL connection string (Railway/Aiven/PlanetScale/local)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/gaul"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak"

# Midtrans (sandbox dulu sebelum production)
MIDTRANS_SERVER_KEY="SB-Mid-server-XXXXXXXX"
MIDTRANS_CLIENT_KEY="SB-Mid-client-XXXXXXXX"
MIDTRANS_IS_PRODUCTION="false"

# RajaOngkir (komerce.id) — untuk kalkulasi ongkos kirim
# Daftar di https://rajaongkir.komerce.id untuk mendapatkan API key
RAJAONGKIR_API_KEY="ganti-dengan-api-key-rajaongkir"
RAJAONGKIR_ORIGIN_CITY_ID="567"  # Kota asal pengiriman (contoh: 567 = Kota Bandung)

# Admin seed (wajib diisi sebelum menjalankan seed — tidak ada default)
SEED_ADMIN_PASSWORD="ganti-password-admin-yang-kuat"
SEED_OWNER_PASSWORD="ganti-password-owner-yang-kuat"